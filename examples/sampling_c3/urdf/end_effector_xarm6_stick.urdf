<?xml version="1.0" encoding="utf-8"?>
<!-- OIM-matched xArm6 pusher stick (oim/models/xarm6/xarm6.xml:213-217):
     capsule r=0.00555, cylinder part 0.1683 m, tip at 0.1794 m from the link6
     flange, welded flush at the flange (no gap). Collision is the tip sphere
     only (GetEERadiusFromPlant requires a Sphere; shaft is visual). -->
<robot name="end_effector_full">
  <material name="stick_purple">
    <color rgba="0.5 0.1 0.7 1"/>
  </material>
  <link name="end_effector_flange">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0897"/>
      <mass value="0.05"/>
      <inertia ixx="0.000119" iyy="0.000119" izz="0.00000077"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0897"/>
      <geometry>
        <cylinder radius="0.00555" length="0.1683"/>
      </geometry>
      <material name="stick_purple"/>
    </visual>
  </link>
  <link name="end_effector_tip">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <mass value="0.007"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.00555"/>
      </geometry>
      <material name="stick_purple"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.00555"/>
      </geometry>
      <drake:proximity_properties>
        <drake:mu_static value="1"/>
        <drake:mu_dynamic value="1"/>
      </drake:proximity_properties>
    </collision>
  </link>
  <joint name="fix_tip_link" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.17385"/>
    <parent link="end_effector_flange"/>
    <child link="end_effector_tip"/>
  </joint>
</robot>
