<?xml version="1.0"?>
<!-- Dynamic ICRA glyph R: 10-vertex convex hull (OIM scenes.py) extruded
     to the pushed C's thickness 0.025 m at its uniform density
     538.3290 kg/m^3. Upstream treats R as a STATIC obstacle; mass,
     COM and inertia here are DERIVED (density x hull area x thickness,
     polygon second moments, centroid COM).
-->
<sdf version="1.7">
  <model name="push_r_glyph">
    <link name="c_glyph_base">
      <inertial><pose>0.001756 -0.003321 0 0 0 0</pose><mass>0.130405833</mass>
        <inertia><ixx>1.055256597e-04</ixx><iyy>1.190952185e-04</iyy><izz>2.110369372e-04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="hull_visual"><pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>icra_glyphs/dynamic/R_prism.obj</uri></mesh></geometry>
      </visual>
      <collision name="hull_collision"><pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>icra_glyphs/dynamic/R_prism.obj</uri><drake:declare_convex/></mesh></geometry>
        <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        <drake:proximity_properties><drake:mu_static>0.3</drake:mu_static><drake:mu_dynamic>0.3</drake:mu_dynamic></drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
