<?xml version="1.0"?>
<!-- Faithful OIM ycb_clutter obstacle field in the OIM-NATIVE frame (rigid
     identity registration, matched benchmark convention: OIM table top z=0
     maps to port z=-0.029). Source of truth: ycb_clutter.xml + scenes.py.
       obs_box       box 0.1^3            @ (0.35,  0.00), shared with single_obstacle
       domino_sugar  box 0.175x0.095x0.06 @ (0.22,  0.20)  (pre-rotated, per URDF)
       spam_can      8-vert hull prism    @ (0.60, -0.16), h=0.0835 (mesh bbox center)
       mustard_bottle 8-vert hull prism   @ (0.15, -0.18), h=0.1913 (mesh bbox center)
     Hull prisms are extrusions of the exact scenes.py footprint polygons,
     matching the scene_icra_sign.sdf pattern. The legacy
     scene_ycb_clutter.sdf carried the registered-frame +0.15/+0.17 x-shift
     and was missing spam_can/mustard_bottle entirely. -->
<sdf version="1.7">
  <model name="scene_ycb_clutter">
    <static>true</static>
    <link name="obs_box"><pose>0.35 0.0 0.021 0 0 0</pose>
      <visual name="obs_box_v"><geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        <material><diffuse>0.85 0.35 0.1 1.0</diffuse></material></visual>
      <collision name="obs_box_c"><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision>
    </link>
    <link name="domino_sugar"><pose>0.22 0.20 0.001 0 0 0</pose>
      <visual name="domino_sugar_v"><geometry><box><size>0.175 0.095 0.06</size></box></geometry>
        <material><diffuse>0.9 0.85 0.3 1.0</diffuse></material></visual>
      <collision name="domino_sugar_c"><geometry><box><size>0.175 0.095 0.06</size></box></geometry></collision>
    </link>
    <link name="spam_can"><pose>0.60 -0.16 0.01275 0 0 0</pose>
      <visual name="spam_can_v"><geometry><mesh><uri>ycb_hulls/spam_can.obj</uri></mesh></geometry>
        <material><diffuse>0.3 0.5 0.85 1.0</diffuse></material></visual>
      <collision name="spam_can_c"><geometry><mesh><uri>ycb_hulls/spam_can.obj</uri>
        <drake:declare_convex/></mesh></geometry></collision>
    </link>
    <link name="mustard_bottle"><pose>0.15 -0.18 0.06665 0 0 0</pose>
      <visual name="mustard_bottle_v"><geometry><mesh><uri>ycb_hulls/mustard_bottle.obj</uri></mesh></geometry>
        <material><diffuse>0.85 0.75 0.2 1.0</diffuse></material></visual>
      <collision name="mustard_bottle_c"><geometry><mesh><uri>ycb_hulls/mustard_bottle.obj</uri>
        <drake:declare_convex/></mesh></geometry></collision>
    </link>
  </model>
</sdf>
