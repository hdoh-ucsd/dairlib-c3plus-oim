+const vector<VectorXd>& C3::GetQPStateSolution() const {
+  if (!last_solve_report_.completed) {
+    throw std::logic_error("No complete finite QP trajectory for current solve");
+  }
+  return qp_state_solution_;
+}
+
+void C3::RunSolve(const VectorXd& x0, bool checked) {
+  auto& report = last_solve_report_;
+  report.attempted = true;
+  report.completed = false;
+  report.had_exception = false;
+  report.invalid_output = false;
+  report.required_qp_count = options_.admm_iter + 1;
+  report.qp_stages.clear();  // Retain capacity across legacy invocations.
+  report.failure_reason.clear();
+  checked_solve_ = checked;
+  if (checked && (x0.size() != n_x_ || !x0.allFinite())) {
+    report.invalid_output = true;
+    report.failure_reason = "Invalid initial state dimensions or nonfinite values";
+    checked_solve_ = false;
+    return;
+  }
+  try {
+    SolveImpl(x0);
+    report.completed =
+        static_cast<int>(report.qp_stages.size()) == report.required_qp_count &&
+        std::all_of(report.qp_stages.begin(), report.qp_stages.end(),
+                    [](const QPStageReport& stage) {
+                      return stage.outcome == QPOutcome::kSucceeded;
+                    });
+    const auto finite_vectors = [](const vector<VectorXd>& values) {
+      return std::all_of(values.begin(), values.end(),
+                         [](const VectorXd& v) { return v.allFinite(); });
+    };
+    if (!finite_vectors(*x_sol_) || !finite_vectors(*lambda_sol_) ||
+        !finite_vectors(*u_sol_) || !finite_vectors(*z_sol_) ||
+        !finite_vectors(*delta_sol_) || !finite_vectors(*w_sol_) ||
+        !finite_vectors(qp_state_solution_)) {
+      report.invalid_output = true;
+      report.completed = false;
+      if (report.failure_reason.empty()) {
+        report.failure_reason = "Nonfinite C3 output after QP execution";
+      }
+    }
+  } catch (const CheckedQPFailure&) {
+    // SolveQP has recorded the precise stage and failure reason.
+  } catch (const std::exception& e) {
+    report.had_exception = true;
+    if (report.failure_reason.empty()) report.failure_reason = e.what();
+    if (!report.qp_stages.empty() &&
+        report.qp_stages.back().outcome == QPOutcome::kNotAttempted) {
+      report.qp_stages.back().outcome = QPOutcome::kException;
+      report.qp_stages.back().failure_reason = e.what();
+    }
+    checked_solve_ = false;
+    if (!checked) throw;  // Preserve exceptions outside the old QP catch.
+  } catch (...) {
+    report.had_exception = true;
+    if (report.failure_reason.empty()) report.failure_reason = "Unknown exception";
+    if (!report.qp_stages.empty() &&
+        report.qp_stages.back().outcome == QPOutcome::kNotAttempted) {
+      report.qp_stages.back().outcome = QPOutcome::kException;
+      report.qp_stages.back().failure_reason = "Unknown exception";
+    }
+    checked_solve_ = false;
+    if (!checked) throw;
+  }
+  checked_solve_ = false;
+}
